# API Credentials for Voice Assistant

# Deepgram ASR API Key (Required for deepgram speech-to-text)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenAI API Key (Required for GPT translation / S2ST)
OPENAI_API_KEY=your_openai_api_key_here

# Azure Speech Key & Region (Required if using Azure Neural TTS)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# ElevenLabs API Key (Required if using ElevenLabs TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Google Gemini API Key (Required for fast Gemini translation & Gemini Live Realtime S2ST)
GEMINI_API_KEY=your_gemini_api_key_here
# Set to 1 to use sub-second direct speech-to-speech translation (Gemini Live WebSocket)
USE_GEMINI_LIVE=1
# Gemini Live Voice: Puck, Aoede, Charon, Fenrir, Kore
GEMINI_LIVE_VOICE=Puck

# --- Recognition: which language(s) to listen in --------------------------
# Default is "ur" - one recogniser, pinned to Urdu. That is what the pipeline
# was tuned against.
#
# "auto" opens TWO recognisers (English and Urdu) on the same microphone and
# decides per utterance which one heard you - see app/providers/dual_asr. It
# is the right answer for a speaker who uses both languages, and it is OFF by
# default because it costs a second recognition stream and adds a settle
# window per utterance. Try it with tools/bench_language.py first.
# OUTGOING_LANGUAGE=ur
# OUTGOING_LANGUAGES=en,ur
# How much English is favoured when the two are close (default 0.05).
# ASR_ENGLISH_BIAS=0.05

# --- Voices ---------------------------------------------------------------
# Run: python tools/check_voices.py     to list what your account has and
# write sample_ur.wav / sample_en.wav so you can pick by ear.
# ELEVEN_UR_VOICE_ID=
# ELEVEN_EN_VOICE_ID=
# Urdu is NOT in Flash v2.5's languages; it needs the v3 family. These only
# apply when ElevenLabs is actually the voice for that direction.
# ELEVEN_URDU_MODEL=eleven_v3
# ELEVEN_ENGLISH_MODEL=eleven_flash_v2_5
