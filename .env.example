# API Credentials for Voice Assistant

# Deepgram ASR API Key (Required for deepgram speech-to-text)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenAI API Key (Required for GPT translation / S2ST)
OPENAI_API_KEY=your_openai_api_key_here

# Azure Speech Key & Region (Required if using Azure Neural TTS)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# ElevenLabs API Key (Required if using ElevenLabs TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
